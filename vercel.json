{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/static/(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/favicon.ico",
      "destination": { "service": "app" }
    },
    {
      "source": "/icon.png",
      "destination": { "service": "app" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}